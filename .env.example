# Auth: an API key (portal > Settings > API Keys) is preferred — works with MFA-enabled accounts.
PF_TOKEN=
# ...or username/password (not supported if the account requires MFA)
# PF_LOGIN=
# PF_PASSWORD=

# Allow create/modify/delete calls (still need confirm=true per call). Default off.
# PF_ALLOW_WRITES=true

# Resellers: act on behalf of a customer UUID
# PF_ON_BEHALF=

# Optional
# PF_API_URL=https://api.packetfabric.com
# PF_TIMEOUT=60
# PF_MAX_RESPONSE_CHARS=60000

# Sign in with PacketFabric (HTTP mode only). Enabled when PF_OAUTH_SECRET and PF_PORTAL_URL are both set;
# PF_PUBLIC_URL is then required. Generate the secret with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PF_OAUTH_SECRET=
# PF_PORTAL_URL=https://portal.packetfabric.com
# PF_PORTAL_ORIGINS=https://portal.packetfabric.com, https://portal-beta.packetfabric.com, https://*.portal.packetfabric.com
# PF_OAUTH_ALLOWED_REDIRECTS=   # exact redirect URIs, comma-separated; defaults to the known AI-app callbacks; loopback is always allowed
# PF_OAUTH_KEY_TTL_SECONDS=2592000
